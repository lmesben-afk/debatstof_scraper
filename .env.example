GOOGLE_SHEET_NAME=Debatstof scraper
GOOGLE_CREDENTIALS_FILE=credentials.json

# Valgfri: sti til SQLite-databasefil.
# Udelades denne linje, gemmes databasen automatisk i Fælles-data/debatstof.db.
# SQLITE_DB_PATH=C:\sti\til\debatstof.db

# Render: indtast login direkte i Render Environment (brug en lang, unik adgangskode).
# APP_USERNAME=
# APP_PASSWORD=
# DATA_DIR=/var/data
# SQLITE_DB_PATH=/var/data/debatstof.db
# SCRAPE_INTERVAL_SECONDS=3600
